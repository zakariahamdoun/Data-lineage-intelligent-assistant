   "source": [
    "import os\n",
    "import requests\n",
    "from requests.auth import HTTPBasicAuth\n",
    "\n",
    "ATLAS_URL = os.getenv(\"ATLAS_URL\", \"http://localhost:21000\")\n",
    "ATLAS_USERNAME = os.getenv(\"ATLAS_USERNAME\", os.getenv(\"ATLAS_USER\", \"admin\"))\n",
    "ATLAS_PASSWORD = os.getenv(\"ATLAS_PASSWORD\")\n",
    "\n",
    "AUTH = HTTPBasicAuth(ATLAS_USERNAME, ATLAS_PASSWORD)\n",
    "\n",
    "HEADERS = {\n",
    "    \"Content-Type\": \"application/json\",\n",
    "    \"Accept\": \"application/json\"\n",
    "}\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# 1. RÉCUPÉRER LA DÉFINITION DU TYPE PostgreSQLColumn\n",
    "# =========================================================\n",
    "\n",
    "type_name = \"PostgreSQLColumn\"\n",
    "\n",
    "response = requests.get(\n",
    "    f\"{ATLAS_URL}/api/atlas/v2/types/typedef/name/{type_name}\",\n",
    "    auth=AUTH,\n",
    "    headers=HEADERS\n",
    ")\n",
    "\n",
    "response.raise_for_status()\n",
    "\n",
    "typedef = response.json()\n",
    "\n",
    "print(\"Type récupéré :\", typedef[\"name\"])\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# 2. AJOUTER L'ATTRIBUT businessLabel\n",
    "# =========================================================\n",
    "\n",
    "attribute_names = [\n",
    "    attr[\"name\"]\n",
    "    for attr in typedef.get(\"attributeDefs\", [])\n",
    "]\n",
    "\n",
    "if \"businessLabel\" not in attribute_names:\n",
    "\n",
    "    typedef[\"attributeDefs\"].append({\n",
    "        \"name\": \"businessLabel\",\n",
    "        \"typeName\": \"string\",\n",
    "        \"isOptional\": True,\n",
    "        \"cardinality\": \"SINGLE\",\n",
    "        \"valuesMinCount\": 0,\n",
    "        \"valuesMaxCount\": 1,\n",
    "        \"isUnique\": False,\n",
    "        \"isIndexable\": True\n",
    "    })\n",
    "\n",
    "    payload = {\n",
    "        \"entityDefs\": [typedef]\n",
    "    }\n",
    "\n",
    "    update_response = requests.put(\n",
    "        f\"{ATLAS_URL}/api/atlas/v2/types/typedefs\",\n",
    "        json=payload,\n",
    "        auth=AUTH,\n",
    "        headers=HEADERS\n",
    "    )\n",
    "\n",
    "    update_response.raise_for_status()\n",
    "\n",
    "    print(\"Attribut businessLabel ajouté avec succès.\")\n",
    "\n",
    "else:\n",
    "    print(\"L'attribut businessLabel existe déjà.\")"
   ]
