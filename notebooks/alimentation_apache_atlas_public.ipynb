    "        timeout=30\n",
    "    )\n",
    "\n",
    "    r.raise_for_status()\n",
    "\n",
    "    return r.json().get(\"entities\", [])\n",
    "\n",
    "\n",
    "for process_name in [\n",
    "    \"Preparation_transactions\",\n",
    "    \"Chargement_SQLite\"\n",
    "]:\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
