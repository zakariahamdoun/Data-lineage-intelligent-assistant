    "\n",
    "    results = search_process(process_name)\n",
    "\n",
    "    for e in results:\n",
    "        attrs = e.get(\"attributes\", {}) or {}\n",
    "\n",
    "        print(\"GUID          :\", e.get(\"guid\"))\n",
    "        print(\"Name          :\", attrs.get(\"name\") or e.get(\"displayText\"))\n",
